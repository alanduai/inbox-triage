{
  "name": "inbox-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Triage of private Gmail (and later WhatsApp) messages into Obsidian, with reviewed replies. Runs on a home Mac mini.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "inbox-triage": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test --test-reporter=spec dist/test/*.test.js",
    "init": "node --disable-warning=ExperimentalWarning dist/src/cli.js init",
    "auth": "node --disable-warning=ExperimentalWarning dist/src/cli.js auth",
    "doctor": "node --disable-warning=ExperimentalWarning dist/src/cli.js doctor --online",
    "poll": "node --disable-warning=ExperimentalWarning dist/src/cli.js poll",
    "send-test": "node --disable-warning=ExperimentalWarning dist/src/cli.js send-test",
    "start": "node --disable-warning=ExperimentalWarning dist/src/cli.js run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@googleapis/gmail": "^22.0.2",
    "google-auth-library": "^11.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
